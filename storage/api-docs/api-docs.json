{
    "swagger": "2.0",
    "info": {
        "title": "BrainLog API",
        "version": "1.0.0"
    },
    "host": "toyohide.work",
    "basePath": "/BrainLog/api",
    "schemes": [
        "http"
    ],
    "paths": {
        "/getTokyoTrainStation": {
            "post": {
                "tags": [
                    "TokyoTrain"
                ],
                "summary": "\u6771\u4eac\u306e\u8def\u7dda\u3068\u99c5\u4e00\u89a7\u3092\u53d6\u5f97",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "properties": {
                                "data": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "train_number": {
                                                "type": "integer",
                                                "example": 0
                                            },
                                            "train_name": {
                                                "type": "string",
                                                "example": "JR\u4e2d\u592e\u7dda"
                                            },
                                            "station": {
                                                "type": "array",
                                                "items": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "string",
                                                            "example": "0-1000005_1"
                                                        },
                                                        "station_name": {
                                                            "type": "string",
                                                            "example": "\u6771\u4eac"
                                                        },
                                                        "address": {
                                                            "type": "string",
                                                            "example": ""
                                                        },
                                                        "lat": {
                                                            "type": "number",
                                                            "format": "float",
                                                            "example": 35.681391
                                                        },
                                                        "lng": {
                                                            "type": "number",
                                                            "format": "float",
                                                            "example": 139.766103
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            },
                            "type": "object"
                        }
                    }
                }
            }
        }
    },
    "definitions": {}
